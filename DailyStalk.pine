//@version=5
indicator("All_High_Lows", overlay=true, max_bars_back=1000, max_lines_count=500)


// Function to check if a given date is a holiday
f_isHoliday(int datetime) =>
    // NYSE Holiday dates taken from: https://www.nyse.com/markets/hours-calendars using yyyy-MM-dd string format
    var _HOLIDAYS = array.from("2025-4-17", "ADD-ENTRIES-HERE")     // Use Holiday-1Day because _date_string lags by 1 day due to candle opening times vs midnight. 
                                                                    // GOOD FRIDAY
    string _date_string = str.tostring(year(datetime)) + "-" +
                          str.tostring(month(datetime)) + "-" +
                          str.tostring(dayofmonth(datetime))
    bool is_holiday = (_HOLIDAYS.indexof(_date_string) >= 0) ? true : false
    [is_holiday, _date_string] 

// Calculate tomorrow's timestamp
tomorrow_timestamp = time + 86400000

// Check if tomorrow is a holiday
[is_tomorrow_holiday, tomorrow_date_string] = f_isHoliday(tomorrow_timestamp)

truncate(number, decimals) =>
    factor = math.pow(10, decimals)
    int(number * factor) / factor
    



D1High = request.security(syminfo.tickerid, 'D', high[1], lookahead=barmerge.lookahead_on)
D1Low = request.security(syminfo.tickerid, 'D', low[1], lookahead=barmerge.lookahead_on)

[D1o1,D1c1,D1o,D1o2, D1h0, D1l0, D1h1, D1l1] = request.security(syminfo.tickerid, 'D', [open[1],close[1],open,open[2], high[0], low[0], high[1], low[1]], lookahead=barmerge.lookahead_on)

clrD1 = color.new(color.maroon,50)
dhl_span = math.min(1440/timeframe.multiplier, 500)
if timeframe.period!='1' and timeframe.isintraday and nz(D1High[1])!=nz(D1High[0])
    hiln = line.new(bar_index-dhl_span, D1High, bar_index, D1High, xloc.bar_index, color=clrD1, style=line.style_solid, width=2)
    line.delete(hiln[1])
    hiln2 = line.new(bar_index, D1High, bar_index+dhl_span, D1High, xloc.bar_index, color=clrD1, style=line.style_solid, width=2)
    line.delete(hiln2[1])

    loln = line.new(bar_index-dhl_span, D1Low, bar_index, D1Low, xloc.bar_index, color=clrD1, style=line.style_solid, width=2)
    line.delete(loln[1])
    loln2 = line.new(bar_index, D1Low, bar_index+dhl_span, D1Low, xloc.bar_index, color=clrD1, style=line.style_solid, width=2)
    line.delete(loln2[1])

    openln = line.new(bar_index, D1o1, bar_index-dhl_span, D1o1, xloc.bar_index, color=color.new(#485dd4,50), style=line.style_solid, width=3)
    line.delete(openln[1])


plot(timeframe.period=='60' and D1o[1]==D1o[0]? D1o : na, color=color.new(#485dd4,42), title="D1 Open", style=plot.style_circles, offset=0, linewidth=3) //style=plot.style_linebr
// plot(timeframe.period=='60' and D1c1[1]==D1c1[0]? D1c1 : na, style=plot.style_linebr, color=color.new(color.maroon,70), title="D1 Close", offset=-1440/timeframe.multiplier, linewidth=1)
plot(timeframe.isintraday? D1High : na, style=plot.style_stepline, color=clrD1, title="D1 High", offset=-dhl_span, linewidth=1)
plot(timeframe.isintraday? D1Low : na, style=plot.style_stepline, color=clrD1, title="D1 Low", offset=-dhl_span, linewidth=1)

PrevD1Offset = syminfo.ticker == "DXY" or syminfo.ticker == "EURUSD" or syminfo.ticker == "GBPUSD" or syminfo.ticker == "AUDUSD" or syminfo.ticker == "NZDUSD" or syminfo.ticker == "USDCAD" or syminfo.ticker == "USDJPY"? -1 : 0

d1_start = syminfo.ticker == 'GBPUSD' or syminfo.ticker == 'EURUSD' or syminfo.ticker == 'USDCAD'?16: syminfo.ticker=='DXY'?18: syminfo.ticker == 'BTCUSD'?0:16


d1_upclose = D1o1 < D1c1
d1_dnclose = D1o1 > D1c1
d1_upperwick = d1_upclose? (D1High-D1c1) : d1_dnclose? (D1High-D1o1) : 0
d1_body = d1_upclose? (D1c1-D1o1) : d1_dnclose? (D1o1-D1c1) : 0
d1_lowerwick = d1_upclose? (D1o1-D1Low) : d1_dnclose? (D1c1-D1Low) : 0
d1_range = D1High - D1Low
var curr_price = 0.0
curr_price := close
curr_proj = curr_price >= D1Low? str.tostring(truncate((curr_price-D1Low)/(D1High-D1Low),2)*100) : str.tostring(truncate((curr_price-D1High)/(D1Low-D1High),2)*100)
var curr_highlight = 0

if d1_upclose               // 1 external high // 2 upperwick // 3 external low // 4 lowerwick // 5 body
    if curr_price>D1High
        curr_highlight := 1
    else if curr_price>D1c1
        curr_highlight := 2
    else if curr_price<D1Low
        curr_highlight := 3
    else if curr_price<D1o1
        curr_highlight := 4
    else //body
        curr_highlight := 5
else if d1_dnclose
    if curr_price>D1High 
        curr_highlight := 1
    else if curr_price>D1o1
        curr_highlight := 2
    else if curr_price<D1Low
        curr_highlight := 3
    else if curr_price<D1c1
        curr_highlight := 4
    else //body
        curr_highlight := 5
else
    curr_highlight := 0





level_150 = (D1High-D1Low)/2+D1High
level_125 = (D1High-D1Low)/4+D1High
level_100 = D1High
level_75 = (D1High-D1Low)/4*3+D1Low
level_67 = D1High-(D1High-D1Low)/3
level_50 = (D1High+D1Low)/2
level_33 = D1Low+(D1High-D1Low)/3
level_25 = (D1High-D1Low)/4+D1Low
level_0 = D1Low
level_n25 = D1Low-(D1High-D1Low)/4
level_n50 = D1Low-(D1High-D1Low)/2

var plevel_150 = (D1High-D1Low)/2+D1High
var plevel_125 = (D1High-D1Low)/4+D1High
var plevel_100 = D1High
var plevel_75 = (D1High-D1Low)/4*3+D1Low
var plevel_66 = (D1High-D1Low)/3*2+D1Low
var plevel_50 = (D1High+D1Low)/2
var plevel_33 = (D1High-D1Low)/3+D1Low
var plevel_25 = (D1High-D1Low)/4+D1Low
var plevel_0 = D1Low
var plevel_n25 = D1Low-(D1High-D1Low)/4
var plevel_n50 = D1Low-(D1High-D1Low)/2

if D1High[21] != D1High[20]
    plevel_150 := level_150
    plevel_125 := level_125
    plevel_100 := level_100
    plevel_75 := level_75
    plevel_50 := level_50
    plevel_25 := level_25
