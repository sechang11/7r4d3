if (timeframe.period=='15' or timeframe.period=='60' or timeframe.period=='30' ) //and barstate.islast and barstate.islastconfirmedhistory
    tfoffset = timeframe.period=='15'? 8 : 4
    levels_width = 2
    levels_style = line.style_solid
    levels_clr = color.new(color.maroon,0)
    eod_bars = timeframe.period == '15' ? 30 : timeframe.period == '30' ? 15 : timeframe.period == '60' ? 8 : 4

    level0_150 = (D1h0-D1l0)/2+D1h0
    level0_125 = (D1h0-D1l0)/4+D1h0
