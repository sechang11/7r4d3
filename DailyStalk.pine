//W1res = input(title="Timeframe", type=input.resolution, defval="W")
[W1High, W1Low, W1c, W1o, W1o0, W1o2] = request.security(syminfo.tickerid,'W', [high[1], low[1], close[1], open[1], open, open[2]], lookahead = barmerge.lookahead_on) 
clrW1 = color.new(color.olive,0)

// Determine if weekly candle is bullish or bearish
W1offset = (syminfo.ticker!='BTCUSD' and syminfo.ticker!='ETHUSD') and timeframe.period =='D'? 5 : (syminfo.ticker!='BTCUSD' and syminfo.ticker!='ETHUSD') and timeframe.isintraday? 7200 : (syminfo.ticker=='BTCUSD' or syminfo.ticker=='ETHUSD') and timeframe.period =='D'? 7 : 10080
W1span = math.min(W1offset/timeframe.multiplier, 500)
widthW1 = 1

W1up = W1o < W1c
W1dn = W1c < W1o


if (timeframe.period=='60' or timeframe.period=='30' or timeframe.period=='15' ) and nz(W1High[1])!=nz(W1High[0])
    hiln = line.new(bar_index-W1span, W1High, bar_index, W1High, xloc.bar_index, color=clrW1, style=line.style_solid, width=widthW1)
    line.delete(hiln[1])
    loln = line.new(bar_index-W1span, W1Low, bar_index, W1Low, xloc.bar_index, color=clrW1, style=line.style_solid, width=widthW1)
    line.delete(loln[1])

    hiln2 = line.new(bar_index, W1High, bar_index+W1span, W1High, xloc.bar_index, color=color.new(#911111,0), style=line.style_dashed, width=2)
    line.delete(hiln2[1])
    loln2 = line.new(bar_index, W1Low, bar_index+W1span, W1Low, xloc.bar_index, color=color.new(#911111,0), style=line.style_dashed, width=2)
    line.delete(loln2[1])

if(timeframe.period=='D')  and nz(W1High[1])!=nz(W1High[0])
    W1o_l = line.new(bar_index,W1o0,bar_index+5,W1o0,color=color.new(color.olive,0), width=2,style=line.style_dotted)
    W1o1_l = line.new(bar_index-5,W1o,bar_index,W1o,color=color.new(color.olive,0), width=2,style=line.style_dotted)
    
    W1o2_l = line.new(bar_index-10,W1o2,bar_index-5,W1o2,color=color.new(color.olive,50), width=1,style=line.style_dotted)
    W1end = line.new(bar_index+5,W1Low,bar_index+5,W1High,color=color.new(color.olive,50), width=1,style=line.style_solid)

    line.delete(W1o2_l[1])
    line.delete(W1o1_l[1])
    line.delete(W1o_l[1])
    line.delete(W1end[1])

    W1High_l = line.new(bar_index-5,W1High,bar_index,W1High,color=color.new(color.olive,0), width=2,style=line.style_dotted)
    W1Low_l = line.new(bar_index-5,W1Low,bar_index,W1Low,color=color.new(color.olive,0), width=2,style=line.style_dotted)
    line.delete(W1High_l[1])
    line.delete(W1Low_l[1])

// if  timeframe.period=='60'
    // w1oln = line.new(bar_index, W1o, bar_index+W1offset/timeframe.multiplier, W1o, xloc.bar_index, extend.none, color=clrW1, style=line.style_arrow_right, width=widthW1)
    // line.delete(w1oln[1])        
    // w1cln = line.new(bar_index, W1c, bar_index+W1offset/timeframe.multiplier, W1c, xloc.bar_index, extend.none, color=clrW1, style=line.style_solid, width=widthW1)
    // line.delete(w1cln[1])
plot(barstate.ishistory and (timeframe.period == 'D' or timeframe.period=='60')? W1High : na, style=plot.style_stepline, color=clrW1, title="W1 High", offset=-W1offset/timeframe.multiplier, linewidth=widthW1)
plot(barstate.ishistory and (timeframe.period == 'D' or timeframe.period=='60')? W1Low : na, style=plot.style_stepline, color=clrW1, title="W1 Low", offset=-W1offset/timeframe.multiplier, linewidth=widthW1)
plot(barstate.ishistory and (timeframe.period == 'D') and (nz(W1o[1])!=nz(W1o[0]) or nz(W1o[2])!=nz(W1o[0]) or nz(W1o[3])!=nz(W1o[0]) or nz(W1o[4])!=nz(W1o[0]))? W1o : na, style=plot.style_linebr, color=clrW1, title="W1 Open", offset=-W1offset/timeframe.multiplier, linewidth=1)

//WEEKLY HIGH LOW CIRCLES
// plot(barstate.ishistory and timeframe.period == 'D' or timeframe.period == '240' or timeframe.period == '60' or timeframe.period == '15' or timeframe.period == '5'? W1High1 : na, style=plot.style_circles, color=color.new(color.purple,69), title="PW1 High", offset=0, linewidth=3)
// plot(barstate.ishistory and timeframe.period == 'D' or timeframe.period == '240' or timeframe.period == '60' or timeframe.period == '15' or timeframe.period == '5'? W1Low1 : na, style=plot.style_circles, color=color.new(color.purple,69), title="PW1 Low", offset=0, linewidth=3)

//WEEKLY TRINITY
if (timeframe.period=='60') and nz(W1High[1])!=nz(W1High[0])
    W1levels_width = 4
    W1levels_style = line.style_solid
    W1levels_clr = color.new(color.olive,0)
    W1level_125 = (W1High-W1Low)/4+W1High
    W1level_100 = W1High
    W1level_75 = (W1High-W1Low)/4*3+W1Low
    W1level_66 = (W1High-W1Low)/3*2+W1Low
    W1level_50 = (W1High+W1Low)/2
    W1level_33 = (W1High-W1Low)/3+W1Low
    W1level_25 = (W1High-W1Low)/4+W1Low
    W1level_0 = W1Low
    W1level_025 = W1Low-(W1High-W1Low)/4

    W1l125 = line.new(bar_index-8, W1level_125, bar_index, W1level_125,xloc.bar_index, extend.none, color=W1levels_clr, style=W1levels_style, width=W1levels_width)
    W1l100 = line.new(bar_index-8, W1level_100, bar_index, W1level_100,xloc.bar_index, extend.none, color=color.new(#2e210a, 0), style=W1levels_style, width=W1levels_width)
    W1l75 = line.new(bar_index-8, W1level_75, bar_index, W1level_75,xloc.bar_index, extend.none, color=W1levels_clr, style=W1levels_style, width=W1levels_width)
    W1l66 = line.new(bar_index-8, W1level_66, bar_index, W1level_66,xloc.bar_index, extend.none, color=W1levels_clr, style=W1levels_style, width=W1levels_width)
    W1l50 = line.new(bar_index-8, W1level_50, bar_index, W1level_50,xloc.bar_index, extend.none, color=W1levels_clr, style=W1levels_style, width=W1levels_width)
    W1l33 = line.new(bar_index-8, W1level_33, bar_index, W1level_33,xloc.bar_index, extend.none, color=W1levels_clr, style=W1levels_style, width=W1levels_width)
    W1l25 = line.new(bar_index-8, W1level_25, bar_index, W1level_25,xloc.bar_index, extend.none, color=W1levels_clr, style=W1levels_style, width=W1levels_width)
    W1l0 = line.new(bar_index-8, W1level_0, bar_index, W1level_0,xloc.bar_index, extend.none, color=color.new(#2e210a, 0), style=W1levels_style, width=W1levels_width)
    W1l025 = line.new(bar_index-8, W1level_025, bar_index, W1level_025,xloc.bar_index, extend.none, color=W1levels_clr, style=W1levels_style, width=W1levels_width)
    line.delete(W1l125[1])
    line.delete(W1l100[1])
    line.delete(W1l75[1])
    line.delete(W1l66[1])
    line.delete(W1l50[1])
    line.delete(W1l25[1])
    line.delete(W1l33[1])
    line.delete(W1l0[1])
    line.delete(W1l025[1])

    whi_to_lo = line.new(bar_index,W1level_100,bar_index,W1level_0,xloc.bar_index,extend.none,color=W1levels_clr, style=line.style_solid)
    line.delete(whi_to_lo[1]) 

    // on RIGHT SIDE OF CHART
    W1l125b = line.new(syminfo.type=="crypto"?bar_index+168:bar_index+120, W1level_125, syminfo.type=="crypto"?bar_index+174:bar_index+128, W1level_125,xloc.bar_index, extend.none, color=W1levels_clr, style=W1levels_style, width=W1levels_width)
    W1l100b = line.new(syminfo.type=="crypto"?bar_index+168:bar_index+120, W1level_100, syminfo.type=="crypto"?bar_index+174:bar_index+128, W1level_100,xloc.bar_index, extend.none, color=color.new(#2e210a, 0), style=W1levels_style, width=W1levels_width)
    W1l75b = line.new(syminfo.type=="crypto"?bar_index+168:bar_index+120, W1level_75, syminfo.type=="crypto"?bar_index+174:bar_index+128, W1level_75,xloc.bar_index, extend.none, color=W1levels_clr, style=W1levels_style, width=W1levels_width)
