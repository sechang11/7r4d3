    level0_33 = D1l0+(D1h0-D1l0)/3
    level0_25 = (D1h0-D1l0)/4+D1l0
    level0_0 = D1l0
    level0_n25 = D1l0-(D1h0-D1l0)/4
    level0_n50 = D1l0-(D1h0-D1l0)/2

