plot((timeframe.period=='60' or timeframe.period=='30'  or timeframe.period=='5' or timeframe.period=='15') and D1High[0]!=D1High[1]? level_125: na, "level_125", color.maroon, 1, plot.style_steplinebr, offset=-1)
plot((timeframe.period=='60' or timeframe.period=='30'  or timeframe.period=='5' or timeframe.period=='15') and D1High[0]!=D1High[1]? level_n25: na, "level_n25", color.maroon, 1, plot.style_steplinebr, offset=-1)
plot((timeframe.period=='60' or timeframe.period=='30'  or timeframe.period=='5' or timeframe.period=='15') and D1High[0]!=D1High[1]? level_n50: na, "level_n50", color.maroon, 1, plot.style_steplinebr, offset=-1)

plot((timeframe.period=='15' or timeframe.period=='5' or timeframe.period=='15') and (D1High[0]!=D1High[1] or D1High[0]!=D1High[2])? level_150: na, "level_150", color.maroon, 2, plot.style_steplinebr, offset=-1)
plot((timeframe.period=='15' or timeframe.period=='5' or timeframe.period=='15') and (D1High[0]!=D1High[1] or D1High[0]!=D1High[2])? level_125: na, "level_125", color.maroon, 2, plot.style_steplinebr, offset=-1)
plot((timeframe.period=='15' or timeframe.period=='5' or timeframe.period=='15') and (D1High[0]!=D1High[1] or D1High[0]!=D1High[2])? level_n25: na, "level_n25", color.maroon, 2, plot.style_steplinebr, offset=-1)
plot((timeframe.period=='15' or timeframe.period=='5' or timeframe.period=='15') and (D1High[0]!=D1High[1] or D1High[0]!=D1High[2])? level_n50: na, "level_n50", color.maroon, 2, plot.style_steplinebr, offset=-1)

if (timeframe.period=='15' or timeframe.period=='60' or timeframe.period=='30' ) and nz(D1High[1])!=nz(D1High[0]) 
    tfoffset = timeframe.period=='15'? 8 : 4
    levels_width = 2
    levels_style = line.style_solid
    levels_clr = color.new(color.maroon,0)

    ln = line.new(bar_index,D1High,bar_index,D1Low,xloc.bar_index,extend.none,color=color.new(color.maroon,70), style=levels_style)
    line.delete(ln[1])
    lnV = line.new(bar_index+dhl_span,D1High,bar_index+dhl_span,D1Low,xloc.bar_index,extend.none,color=color.new(color.maroon,70), style=levels_style)
    line.delete(lnV[1])
    l150 = line.new(bar_index+dhl_span, level_150, bar_index, level_150,xloc.bar_index, extend.none, color=levels_clr, style=levels_style, width=2)
    l125 = line.new(bar_index+tfoffset, level_125, bar_index, level_125,xloc.bar_index, extend.none, color=levels_clr, style=levels_style, width=1)
    l100 = line.new(bar_index+tfoffset, level_100, bar_index, level_100,xloc.bar_index, extend.none, color=levels_clr, style=levels_style, width=levels_width)
