// Function to get the next third Friday
// get_next_third_friday(current_time) =>
//     current_year = year(current_time)
//     current_month = month(current_time)
//     current_day = dayofmonth(current_time)
    
//     // Get the first day of current month
//     first_of_month = timestamp(syminfo.timezone, current_year, current_month, 1, 0, 0)
    
//     // Calculate how many Fridays have passed this month
//     // Add days since start of month (current_day - 1) to the initial weekday offset
//     // Subtract Friday's position to align with Friday, then divide by 7 to get number of weeks
//     fridays_passed = math.floor((current_day - 1 + dayofweek(first_of_month) - dayofweek.friday) / 7)
    
//     // Move to next month if we've already passed the third Friday
//     if fridays_passed >= 3
//         current_month := current_month + 1
//         if current_month > 12
//             current_year := current_year + 1
//             current_month := 1
    
//     // Find the first day of the target month
//     first_day = timestamp(syminfo.timezone, current_year, current_month, 1, 0, 0)
    
//     // Find the first Friday
//     days_until_friday = dayofweek.friday - dayofweek(first_day)
//     if days_until_friday <= 0
//         days_until_friday := days_until_friday + 7
//     first_friday = first_day + days_until_friday * 86400000
    
//     // Get the third Friday
//     third_friday = first_friday + 14 * 86400000
//     third_friday

get_next_third_friday(current_time) =>
    current_year = year(current_time)
    current_month = month(current_time)

    // Get the first day of the current month
    first_of_month = timestamp(syminfo.timezone, current_year, current_month, 1, 0, 0)

    // Find the first Friday of the current month
    days_until_first_friday = dayofweek.friday - dayofweek(first_of_month)
    if days_until_first_friday <= 0
        days_until_first_friday := days_until_first_friday + 7
    first_friday_current_month = first_of_month + days_until_first_friday * 86400000

    // Calculate the third Friday of the current month
    third_friday_current_month = first_friday_current_month + 14 * 86400000

    next_third_friday = third_friday_current_month

    // If the third Friday of the current month has already passed, move to the next month
    if current_time > third_friday_current_month
        current_month := current_month + 1
        if current_month > 12
            current_year := current_year + 1
            current_month := 1

        // Find the first day of the next month
        first_day_next_month = timestamp(syminfo.timezone, current_year, current_month, 1, 0, 0)

        // Find the first Friday of the next month
        days_until_first_friday_next_month = dayofweek.friday - dayofweek(first_day_next_month)
        if days_until_first_friday_next_month <= 0
            days_until_first_friday_next_month := days_until_first_friday_next_month + 7
        first_friday_next_month = first_day_next_month + days_until_first_friday_next_month * 86400000

        // Calculate the third Friday of the next month
        next_third_friday := first_friday_next_month + 14 * 86400000

    next_third_friday

// plot(time == get_next_third_friday(time) ? high : na, "Next Third Friday", color=color.green, linewidth=2, style)



// Function to get the next first of the month
get_next_first_of_month(current_time) =>
    current_year = year(current_time)
    current_month = month(current_time)
    
    // Move to next month
    current_month := current_month + 1
    if current_month > 12
        current_year := current_year + 1
        current_month := 1
    
    // Get the first day of next month
    timestamp(syminfo.timezone, current_year, current_month, 1, 0, 0)

var target_date = 0
var date_type = ""

if barstate.islast and timeframe.period=='D'
    next_third_friday = get_next_third_friday(timenow)
    next_first_of_month = get_next_first_of_month(timenow)
    
    // Choose the earlier of the two dates
    target_date := math.min(next_third_friday, next_first_of_month)
    date_type := dayofweek(target_date) == dayofweek.friday ? "Third Friday" : "First of Month"

    // Draw the line
    line_start = time > target_date ? time : target_date
    line.new(line_start, mxm_hi, line_start, mxm_lo, xloc.bar_time, color=mxm_clr, style=line.style_solid, width=2)

    var mxmfrange = 0.0
    var mxmfthird = 0.0
    var mxmfquart = 0.0
    var mxmf125 = 0.0
    var mxmf100 = 0.0
    var mxmf66 = 0.0
    var mxmf50 = 0.0
    var mxmf33 = 0.0
    var mxmf0 = 0.0
    var mxmfn25 = 0.0
    mxmfrange := mxm_hi - mxm_lo
    mxmfthird := mxmfrange / 3
    mxmfquart := mxmfrange / 4
    mxmf125 := mxm_hi + mxmfquart
    mxmf100 := mxm_hi
    mxmf66 := mxm_hi - mxmfthird
    mxmf50 := mxm_hi - mxmfquart * 2
    mxmf33 := mxm_lo + mxmfthird
    mxmf0 := mxm_lo
    mxmfn25 := mxm_lo - mxmfquart

    line.new(line_start, mxmf125, line_start+86400000, mxmf125, xloc.bar_time, color=mxm_clr, style=line.style_solid, width=2)
    line.new(line_start, mxmf100, line_start+86400000, mxmf100, xloc.bar_time, color=mxm_clr, style=line.style_solid, width=2)
    line.new(line_start, mxmf66, line_start+86400000, mxmf66, xloc.bar_time, color=mxm_clr, style=line.style_solid, width=2)
    line.new(line_start, mxmf50, line_start+86400000, mxmf50, xloc.bar_time, color=mxm_clr, style=line.style_solid, width=2)
    line.new(line_start, mxmf33, line_start+86400000, mxmf33, xloc.bar_time, color=mxm_clr, style=line.style_solid, width=2)
    line.new(line_start, mxmf0, line_start+86400000, mxmf0, xloc.bar_time, color=mxm_clr, style=line.style_solid, width=2)
    line.new(line_start, mxmfn25, line_start+86400000, mxmfn25, xloc.bar_time, color=mxm_clr, style=line.style_solid, width=2)





