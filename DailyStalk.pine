    //l50 = line.new(bar_index+tfoffset, level_50, bar_index, level_50,xloc.bar_index, extend.none, color=levels_clr, style=levels_style, width=levels_width)
    l33 = line.new(bar_index+tfoffset, level_33, bar_index, level_33,xloc.bar_index, extend.none, color=levels_clr, style=levels_style, width=levels_width)
    //l25 = line.new(bar_index+tfoffset, level_25, bar_index, level_25,xloc.bar_index, extend.none, color=levels_clr, style=levels_style, width=levels_width)
    l0 = line.new(bar_index+tfoffset, level_0, bar_index, level_0,xloc.bar_index, extend.none, color=levels_clr, style=levels_style, width=levels_width)
    l025 = line.new(bar_index+tfoffset, level_n25, bar_index, level_n25,xloc.bar_index, extend.none, color=levels_clr, style=levels_style, width=1)
    l050 = line.new(bar_index+dhl_span, level_n50, bar_index, level_n50,xloc.bar_index, extend.none, color=levels_clr, style=levels_style, width=2)

    linefill.new(l125,l100,color.new(color.maroon,95))
    linefill.new(l0,l025,color.new(color.maroon,95))
    line.delete(l150[1])
    line.delete(l125[1])
    line.delete(l100[1])
    //line.delete(l75[1])
    line.delete(l67[1])
    //line.delete(l50[1])
    line.delete(l33[1])
    //line.delete(l25[1])
    line.delete(l0[1])
    line.delete(l025[1])
    line.delete(l050[1])

//15O 150 D1 H1 OPEN LINE
plot((timeframe.period=='60' or timeframe.period=='30') and D1o1[1]==D1o1[0] and (D1High > plevel_150 or D1Low < plevel_n50) and D1o1 < D1c1 ? D1l1 : na, style=plot.style_linebr, color=color.new(#5c9769, 0), title="D1 15O Open", offset=-1440/timeframe.multiplier, linewidth=12)
plot((timeframe.period=='60' or timeframe.period=='30') and D1o1[1]==D1o1[0] and (D1High > plevel_150 or D1Low < plevel_n50) and D1o1 > D1c1 ? D1h1 : na, style=plot.style_linebr, color=color.new(#5c9769, 0), title="D1 15O Open", offset=-1440/timeframe.multiplier, linewidth=12)
 
