//H1
H1High = request.security(syminfo.tickerid, '60', high[1], lookahead=barmerge.lookahead_on)
H1Low = request.security(syminfo.tickerid, '60', low[1], lookahead=barmerge.lookahead_on)
[H1open,H1open1,H1open2] = request.security(syminfo.tickerid, '60', [open,open[1],open[2]], lookahead=barmerge.lookahead_on)
H1Offset = -60/timeframe.multiplier ///(hour == 16 and timeframe.period == '5') ? -20 : (timeframe.period == '15') ? -4: (timeframe.period == '5') ? -12 : (timeframe.period == '1') ? -60 : 0
H1Offset2 = -60/timeframe.multiplier/2
clrH1oc = color.new(color.maroon,30)

var H1o_l = line.new(1,1,1,1)
var H1o1_l = line.new(1,1,1,1)
var H1o2_l = line.new(1,1,1,1)
if timeframe.period=='1' or timeframe.period=='5'
    if minute==0
        H1o_l := line.new(bar_index,H1open,bar_index+60/timeframe.multiplier,H1open,color=clrH1oc, width=4,style=line.style_solid)
        H1o1_l := line.new(bar_index-60/timeframe.multiplier,H1open1,bar_index,H1open1,color=clrH1oc, width=4,style=line.style_solid)
        H1o2_l := line.new(bar_index-120/timeframe.multiplier,H1open2,bar_index-60/timeframe.multiplier,H1open2,color=clrH1oc, width=1,style=line.style_solid)
        line.delete(H1o2_l[3])
        line.delete(H1o1_l[3])
        line.delete(H1o_l[3])

clrH1 = timeframe.period=='15'?color.new(color.maroon,50):color.new(color.maroon,0)
if (timeframe.period=='5' or timeframe.period=='1')and nz(H1High[1])!=nz(H1High[0])
    if timeframe.period=='5' or timeframe.period=='1'
        ln = line.new(bar_index,H1High,bar_index,H1Low,xloc.bar_index,extend.none,color=color.new(color.maroon,70), style=line.style_solid)
        line.delete(ln[1])
        lnx = line.new(bar_index+60/timeframe.multiplier,H1High,bar_index+60/timeframe.multiplier,H1Low,xloc.bar_index,extend.none,color=color.new(color.maroon,70), style=line.style_solid)
        line.delete(lnx[1])        
    hiln = line.new(bar_index-60/timeframe.multiplier, H1High, bar_index, H1High, xloc.bar_index, color=clrH1, style=line.style_solid, width=1)
    line.delete(hiln[1])
    hiln2 = line.new(bar_index, H1High, bar_index+60/timeframe.multiplier, H1High, xloc.bar_index, color=color.new(color.maroon,0), style=line.style_dotted, width=1)
    line.delete(hiln2[1])
    loln = line.new(bar_index-60/timeframe.multiplier, H1Low, bar_index, H1Low, xloc.bar_index, color=clrH1, style=line.style_solid, width=1)
    line.delete(loln[1])
    loln2 = line.new(bar_index, H1Low, bar_index+60/timeframe.multiplier, H1Low, xloc.bar_index, color=color.new(color.maroon,0), style=line.style_dotted, width=1)
    line.delete(loln2[1])

plot(timeframe.period == '5' or timeframe.period == '1'? H1High : na, style=plot.style_stepline, color=clrH1, title="H1 High", offset=H1Offset, linewidth=1)
plot(timeframe.period == '5' or timeframe.period == '1'? H1Low : na, style=plot.style_stepline, color=clrH1, title="H1 Low", offset=H1Offset, linewidth=1)
//plot((timeframe.period == '15' or timeframe.period == '5' or timeframe.period == '1') and (H1open1[0]!=H1open1[1] or H1open1[0]!=H1open1[2] or H1open1[0]!=H1open1[3])? H1open1 : na, style=plot.style_linebr, color=color.new(color.black,0), title="H1 Open", offset=H1Offset, linewidth=3)
plot((timeframe.period == '5' or timeframe.period == '1') and (H1open1[0]==H1open1[1])? H1open1 : na, style=plot.style_linebr, color=clrH1oc, title="H1 Open", offset=H1Offset, linewidth=1)


// TABLE
if timeframe.period=='60' or timeframe.period=='30' 
    //div = syminfo.type=="futures"? syminfo.mintick : syminfo.pointvalue
    quart = math.floor((D1High-D1Low)/4/syminfo.mintick)
    tick_tbl = table.new(position.top_right,1,7,border_width=0)
    //table.cell(tick_tbl, 0, 0, " : " + str.tostring(syminfo.mintick/1*syminfo.pointvalue))
    table.cell(tick_tbl, 0, 1, "$/tick: " + str.tostring(syminfo.mintick/1*syminfo.pointvalue))
    table.cell(tick_tbl, 0, 2, " " + str.tostring(quart*syminfo.mintick/1*syminfo.pointvalue))
    table.cell(tick_tbl, 0, 3, "25: " + str.tostring(quart))
    table.cell(tick_tbl, 0, 4, "33: " + str.tostring(math.floor((D1High-D1Low)/3/syminfo.mintick)))
    table.cell(tick_tbl, 0, 5, "50: " + str.tostring(math.floor((D1High-D1Low)/2/syminfo.mintick)))
    table.cell(tick_tbl, 0, 6, "H1: " + str.tostring(math.floor((H1High-H1Low)/syminfo.mintick)))

