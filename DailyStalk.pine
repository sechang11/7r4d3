    // line.delete(ln[1])
    // lnV = line.new(bar_index+1440/timeframe.multiplier,D1h0,bar_index+1440/timeframe.multiplier,D1l0,xloc.bar_index,extend.none,color=color.new(color.maroon,70), style=levels_style)
    // line.delete(lnV[1])

    l150 = line.new(bar_index+tfoffset+eod_bars, level0_150, bar_index+eod_bars, level0_150,xloc.bar_index, extend.none, color=levels_clr, style=levels_style, width=2)
    l125 = line.new(bar_index+tfoffset+eod_bars, level0_125, bar_index+eod_bars, level0_125,xloc.bar_index, extend.none, color=levels_clr, style=levels_style, width=1)
    l100 = line.new(bar_index+tfoffset+eod_bars, level0_100, bar_index+eod_bars, level0_100,xloc.bar_index, extend.none, color=levels_clr, style=levels_style, width=levels_width)
    //l75 = line.new(bar_index+tfoffset+eod_bars, level0_75, bar_index+eod_bars, level0_75,xloc.bar_index, extend.none, color=levels_clr, style=levels_style, width=levels_width)
    l67 = line.new(bar_index+tfoffset+eod_bars, level0_67, bar_index+eod_bars, level0_67,xloc.bar_index, extend.none, color=levels_clr, style=levels_style, width=levels_width)
    //l50 = line.new(bar_index+tfoffset+eod_bars, level0_50, bar_index+eod_bars, level0_50,xloc.bar_index, extend.none, color=levels_clr, style=levels_style, width=levels_width)
    l33 = line.new(bar_index+tfoffset+eod_bars, level0_33, bar_index+eod_bars, level0_33,xloc.bar_index, extend.none, color=levels_clr, style=levels_style, width=levels_width)
    //l25 = line.new(bar_index+tfoffset+eod_bars, level0_25, bar_index+eod_bars, level0_25,xloc.bar_index, extend.none, color=levels_clr, style=levels_style, width=levels_width)
    l0 = line.new(bar_index+tfoffset+eod_bars, level0_0, bar_index+eod_bars, level0_0,xloc.bar_index, extend.none, color=levels_clr, style=levels_style, width=levels_width)
    l025 = line.new(bar_index+tfoffset+eod_bars, level0_n25, bar_index+eod_bars, level0_n25,xloc.bar_index, extend.none, color=levels_clr, style=levels_style, width=1)
    l050 = line.new(bar_index+tfoffset+eod_bars, level0_n50, bar_index+eod_bars, level0_n50,xloc.bar_index, extend.none, color=levels_clr, style=levels_style, width=2)

    linefill.new(l125,l100,color.new(color.maroon,95))
    linefill.new(l0,l025,color.new(color.maroon,95))
    line.delete(l150[1])
    line.delete(l125[1])
    line.delete(l100[1])
