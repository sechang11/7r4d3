    // table.cell(change, 1, 6, "last_up_pattern_o60: " + str.tostring(truncate(last_up_pattern_o60,4)) , text_color=color.new(#4745b6, 30), bgcolor = color.new(#f4ca86, 33), text_halign = text.align_left, text_size=size.large)
    // table.cell(change, 1, 7, "last_up_pattern_range60: " + str.tostring(truncate(last_up_pattern_range60,4)) , text_color=color.new(#4745b6, 30), bgcolor = color.new(#f4ca86, 33), text_halign = text.align_left, text_size=size.large)
    // table.cell(change, 1, 8, "H1o0: " + str.tostring(truncate(H1o0,4)) , text_color=color.new(#4745b6, 30), bgcolor = color.new(#f4ca86, 33), text_halign = text.align_left, text_size=size.large)

//else if timeframe.period=='D'
//    table.cell(change, 0, 0,str.tostring(truncate(projectionD-1,2)), text_color=color.new(color.black, 0), text_halign = text.align_center, text_size=textSize)
    // table.cell(change, 0, 1, str.tostring(minute(time))+":Q"+str.tostring(q), text_color=color.new(color.black, 0), bgcolor = color.new(#f4ca86, 33), text_halign = text.align_center, text_size=size.large)
//    table.cell(change, 0, 1, "" , text_color=color.new(color.black, 0), bgcolor=clr_candlestateD, text_halign = text.align_center, text_size=textSize)
//    table.cell(change, 0, 2, " " , text_color=color.new(color.black, 0), bgcolor=clr_tmpcandlestateD, text_halign = text.align_center, text_size=textSize)




// ── D.STK – Daily Stalk Zones (reuses D1High, D1Low, D1o1, D1c1 from above) ──
// Plots ~3 months by default on sub-1H timeframes using plot+fill (no boxes)

dstk_range = D1High - D1Low
dstk_bull  = D1c1 >= D1o1
dstk_upperTop = dstk_bull ? D1High + dstk_range * 0.25 : D1Low + dstk_range * 0.75
dstk_upperBot = dstk_bull ? D1High                     : D1Low + dstk_range * 0.66
dstk_lowerTop = dstk_bull ? D1Low + dstk_range * 0.33  : D1Low
dstk_lowerBot = dstk_bull ? D1Low + dstk_range * 0.25  : D1Low - dstk_range * 0.25

dstk_show = timeframe.in_seconds() < 3600 and dstk_range > 0

// Historical D.STK via plot+fill
p_dstk_ut = plot(dstk_show ? dstk_upperTop : na, "DSTK Up Top", color.new(color.rgb(140,60,60), 100), 1, plot.style_steplinebr)
p_dstk_ub = plot(dstk_show ? dstk_upperBot : na, "DSTK Up Bot", color.new(color.rgb(140,60,60), 100), 1, plot.style_steplinebr)
fill(p_dstk_ut, p_dstk_ub, color.new(color.rgb(130, 50, 50), 82), "DSTK Upper Zone")

p_dstk_lt = plot(dstk_show ? dstk_lowerTop : na, "DSTK Lo Top", color.new(color.rgb(140,60,60), 100), 1, plot.style_steplinebr)
p_dstk_lb = plot(dstk_show ? dstk_lowerBot : na, "DSTK Lo Bot", color.new(color.rgb(140,60,60), 100), 1, plot.style_steplinebr)
fill(p_dstk_lt, p_dstk_lb, color.new(color.rgb(130, 50, 50), 82), "DSTK Lower Zone")

// Today's D.STK projected forward as boxes
var box dstk_upperBox = na
var box dstk_lowerBox = na
if barstate.islast and dstk_show
    box.delete(dstk_upperBox)
    box.delete(dstk_lowerBox)
    dstk_upperBox := box.new(left=bar_index, top=dstk_upperTop, right=bar_index + 50, bottom=dstk_upperBot, border_color=color.new(color.rgb(140,60,60), 100), border_width=0, extend=extend.none, xloc=xloc.bar_index, bgcolor=color.new(color.rgb(130, 50, 50), 82))
    dstk_lowerBox := box.new(left=bar_index, top=dstk_lowerTop, right=bar_index + 50, bottom=dstk_lowerBot, border_color=color.new(color.rgb(140,60,60), 100), border_width=0, extend=extend.none, xloc=xloc.bar_index, bgcolor=color.new(color.rgb(130, 50, 50), 82))

// ── D.MTX Level – Giant label on right side following current price ──
dmtx_pct = dstk_range > 0 ? (close - D1Low) / dstk_range * 100.0 : na
dmtx_level = math.round(dmtx_pct)
dmtx_inStalk = (close >= dstk_upperBot and close <= dstk_upperTop) or (close >= dstk_lowerBot and close <= dstk_lowerTop)
dmtx_clr = dmtx_inStalk ? color.rgb(0, 200, 90) : dmtx_pct >= 0 and dmtx_pct <= 100 ? color.rgb(80, 70, 55) : dmtx_pct > 100 ? color.rgb(0, 150, 70) : color.rgb(200, 50, 50)
dmtx_txt = not na(dmtx_level) ? str.tostring(dmtx_level) + (dmtx_inStalk ? " !" : "") : ""
dmtx_sz = dmtx_inStalk ? size.huge : size.large

var label dmtx_label = na
if barstate.islast and timeframe.isintraday
    if not na(dmtx_label)
        label.delete(dmtx_label)
    dmtx_label := label.new(bar_index + 20, close, dmtx_txt, xloc.bar_index, yloc.price, color(na), label.style_none, dmtx_clr, dmtx_sz, text.align_left)

// ── S.MTX – Swing Matrix Level (Thrust-based, 15min only) ──
var label smx_label = na

if timeframe.period == '15'
    // Thrust logic: track flow changes via 4-bar extreme breaks
    var float tt_highHolder  = na
    var float tt_lowHolder   = na
    var float tt_swingHigh   = na
    var float tt_swingLow    = na
    var int   tt_tFlow       = 1   // 1=up, 2=down
    var int   tt_tTrend      = 1   // 1=bullish, 2=bearish (set by BOS)
    var bool  tt_check4UpBos = false
    var bool  tt_check4DnBos = false
    var int   tt_swingHighBar = na  // bar_index when swing high was set
    var int   tt_swingLowBar  = na  // bar_index when swing low was set
    var float tt_bosHigh      = na  // swing high confirmed by BOS (bearish)
    var int   tt_bosHighBar   = na
    var float tt_bosLow       = na  // swing low confirmed by BOS (bullish)
    var int   tt_bosLowBar    = na

    // Pivot detection
    tt_isLowPivot  = low[0] <= low[1] and low[0] <= low[2] and low[0] <= low[3] and low[0] <= low[4]
    tt_isHighPivot = high[0] >= high[1] and high[0] >= high[2] and high[0] >= high[3] and high[0] >= high[4]

    // 4-bar extremes
    tt_hh4 = ta.highest(high, 4)[1]
    tt_ll4 = ta.lowest(low, 4)[1]

    // Update placeholders (track bar_index of the pivot)
    var int tt_highHolderBar = na
    var int tt_lowHolderBar  = na
    if tt_isLowPivot
        tt_lowHolder := low
        tt_lowHolderBar := bar_index
    if tt_isHighPivot
        tt_highHolder := high
        tt_highHolderBar := bar_index

    // Flow changes (thrust detection)
    if tt_tFlow == 1
        if low < tt_ll4
            tt_swingHigh := tt_highHolder
            tt_swingHighBar := nz(tt_highHolderBar, bar_index)
            tt_tFlow := 2
            tt_check4UpBos := true
    if tt_tFlow == 2
        if high > tt_hh4
            tt_swingLow := tt_lowHolder
            tt_swingLowBar := nz(tt_lowHolderBar, bar_index)
            tt_tFlow := 1
            tt_check4DnBos := true
    if tt_tFlow == 1
        if low < tt_ll4
            tt_swingHigh := tt_highHolder
            tt_swingHighBar := nz(tt_highHolderBar, bar_index)
            tt_tFlow := 2
            tt_check4UpBos := true

    // BOS logic — trend changes on swing break
    // Up BOS: price breaks above swingHigh → bullish trend
    if tt_check4UpBos
        if high > tt_swingHigh
            tt_check4UpBos := false
            tt_tTrend := 1
            tt_bosLow := tt_swingLow
            tt_bosLowBar := tt_swingLowBar
    // Down BOS: price breaks below swingLow → bearish trend
    if tt_check4DnBos
        if low < tt_swingLow
            tt_check4DnBos := false
            tt_tTrend := 2
            tt_bosHigh := tt_swingHigh
            tt_bosHighBar := tt_swingHighBar

    // Swing Matrix level: BOS swing as anchor + extreme between BOS swing and current bar
    smx_barsSinceBosHigh = not na(tt_bosHighBar) ? bar_index - tt_bosHighBar + 1 : 1
    smx_barsSinceBosLow  = not na(tt_bosLowBar)  ? bar_index - tt_bosLowBar  + 1 : 1
    smx_top    = tt_tTrend == 2 ? nz(tt_bosHigh) : ta.highest(high, math.max(smx_barsSinceBosLow, 1))
    smx_bottom = tt_tTrend == 2 ? ta.lowest(low, math.max(smx_barsSinceBosHigh, 1)) : nz(tt_bosLow)
    smx_range  = smx_top - smx_bottom
    smx_pct    = smx_range > 0 ? (close - smx_bottom) / smx_range * 100.0 : na
    smx_level  = not na(smx_pct) ? math.round(smx_pct) : na

    // Fair (F) = price within effective range; Unfair (U) = outside
    smx_isFair = smx_range > 0 and close >= smx_bottom and close <= smx_top
    smx_fu     = smx_isFair ? "F" : "U"
    // Deep retracement: 67+ in downtrend or 33- in uptrend, only in fair value
    smx_deepRet = smx_isFair and not na(smx_level) and ((tt_tTrend == 2 and smx_level >= 67) or (tt_tTrend == 1 and smx_level <= 33))
    smx_txt    = not na(smx_level) ? smx_fu + " " + str.tostring(smx_level) + (smx_deepRet ? " !" : "") : ""

    // Color: bullish trend=green, bearish trend=maroon (based on BOS)
    smx_clr = tt_tTrend == 1 ? color.green : color.maroon
    smx_sz  = smx_deepRet ? size.huge : size.large

    // Position: bullish=above D.MTX, bearish=below D.MTX
    smx_yOffset = ta.atr(14) * 0.8
    smx_y       = tt_tTrend == 1 ? close + smx_yOffset : close - smx_yOffset

    // DEBUG: draw horizontal lines at smx_top and smx_bottom (latest bar only)
    var line smx_dbg_top = na
    var line smx_dbg_bot = na
    if barstate.islast and smx_range > 0
        if not na(smx_dbg_top)
            line.delete(smx_dbg_top)
        if not na(smx_dbg_bot)
            line.delete(smx_dbg_bot)
        smx_dbg_top := line.new(bar_index, smx_top, bar_index + 3, smx_top, color=color.black, style=line.style_solid, width=4)
        smx_dbg_bot := line.new(bar_index, smx_bottom, bar_index + 3, smx_bottom, color=color.black, style=line.style_solid, width=4)

    if barstate.islast
        if not na(smx_label)
            label.delete(smx_label)
        smx_label := label.new(bar_index + 20, smx_y, smx_txt, xloc.bar_index, yloc.price, color(na), label.style_none, smx_clr, smx_sz, text.align_left)
else
    // Not on 15min — clean up any stale label
    if not na(smx_label)
        label.delete(smx_label)
        smx_label := na
