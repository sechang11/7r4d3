    plevel_n25 := level_n25
    plevel_n50 := level_n50

plot((timeframe.period=='60' or timeframe.period=='30') and D1o1[1]==D1o1[0]? level_67 : na, style=plot.style_linebr, color=color.new(color.maroon,70), title="D1 Open", offset=-1440/timeframe.multiplier, linewidth=1)
plot((timeframe.period=='60' or timeframe.period=='30') and D1c1[1]==D1c1[0]? level_33 : na, style=plot.style_linebr, color=color.new(color.maroon,70), title="D1 Close", offset=-1440/timeframe.multiplier, linewidth=1)

if timeframe.period!='1' and timeframe.isintraday and nz(D1High[1])!=nz(D1High[0])
