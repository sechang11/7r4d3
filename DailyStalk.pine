// OPEX OPEN LINE 3RD FRIDAY
var true_friday = syminfo.type=="crypto" or syminfo.type=="stock"? dayofweek.friday : dayofweek.thursday
//var true_friday = dayofweek.friday
var fricount = 0
var MxM = 0.0
if timeframe.period=='D' and nz(mo[1])!=nz(mo[0])
    fricount := 0
    MxM := mo
if timeframe.period=='D'and fricount==2 and dayofweek(tomorrow_timestamp) == true_friday
    if is_tomorrow_holiday
        fricount += 1  // Increment fricount if tomorrow is a holiday
if timeframe.period=='D'and fricount<3 and dayofweek(time)==true_friday
    fricount += 1
if timeframe.period=='D'and fricount==3
    MxM := open
    fricount += 1
