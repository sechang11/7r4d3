// DAY OPENING PRICE PLOT - REAL ONE FOR BOTH 60 AND 15 -- FOR 60 ONLY
// 5c9769
[h1ltf_hi, h1ltf_lo] = request.security_lower_tf(syminfo.tickerid, timeframe.period=='60'?'15':na, [high, low])
var niteo_hi = 0.0
var niteo_lo = 0.0
var dayo_hi = 0.0
var dayo_lo = 0.0

var pniteo_hi = 0.0
var pniteo_lo = 0.0
var pdayo_hi = 0.0
var pdayo_lo = 0.0

var pniteo_hi_check = 0
var pniteo_lo_check = 0
var pniteo_touched = false
var pdayo_hi_check = 0
var pdayo_lo_check = 0
var pdayo_touched = false

offset1day = -1380 / timeframe.multiplier

getArrayValue(float[] array, int idx) =>
    if idx >= 0 and array.size(array) > idx
        array.get(array, idx)
    else
        na

if timeframe.period=='60' and ny_eff_hour == ny_eff_hr     // DAY SESS FIRST BAR (DST-safe)
    // if not pdayo_touched
    //     pdayo1_hi_line = line.new(bar_index-23, pniteo_hi, bar_index-14, pniteo_hi, xloc.bar_index, extend.none, color.new(color.black,100),line.style_solid,1)
    //     pdayo1_lo_line = line.new(bar_index-23, pniteo_lo, bar_index-14, pniteo_lo, xloc.bar_index, extend.none, color.new(color.black,100),line.style_solid,1)
    //     linefill.new(pdayo1_hi_line,pdayo1_lo_line,color.new(color.maroon,50))
    //     line.delete(pdayo1_hi_line[1])
    //     line.delete(pdayo1_lo_line[1])    
    pniteo_hi_check := 0
    pniteo_lo_check := 0    
    pniteo_hi := niteo_hi
    pniteo_lo := niteo_lo
    niteo_hi := 0
    niteo_lo := 0
    dayo_hi := getArrayValue(h1ltf_hi,2)
    dayo_lo := getArrayValue(h1ltf_lo,2)
    pniteo_hi_check := dayo_lo < pniteo_hi or getArrayValue(h1ltf_lo,3) < pniteo_hi? 1 : 0
    pniteo_lo_check := dayo_hi > pniteo_lo or getArrayValue(h1ltf_hi,3) > pniteo_lo? 1 : 0
if timeframe.period=='60' and ny_eff_hour == lo_eff_hr     // NITE SESS FIRST BAR (DST-safe)
    // if not pniteo_touched
    //     pniteo1_hi_line = line.new(bar_index-23, pniteo_hi, bar_index-9, pniteo_hi, xloc.bar_index, extend.none, color.new(color.black,100),line.style_solid,1)
    //     pniteo1_lo_line = line.new(bar_index-23, pniteo_lo, bar_index-9, pniteo_lo, xloc.bar_index, extend.none, color.new(color.black,100),line.style_solid,1)
    //     linefill.new(pniteo1_hi_line,pniteo1_lo_line,color.new(color.maroon,50))
    //     line.delete(pniteo1_hi_line[1])
    //     line.delete(pniteo1_lo_line[1])    
    pdayo_hi_check := 0
    pdayo_lo_check := 0
    pdayo_hi := dayo_hi
    pdayo_lo := dayo_lo
    dayo_hi := 0
    dayo_lo := 0
    niteo_hi := getArrayValue(h1ltf_hi,array.size(h1ltf_hi)-1)
    niteo_lo := getArrayValue(h1ltf_lo,array.size(h1ltf_lo)-1)

if hour!=ny_hr and niteo_hi==0 // DAY SESS ACTIVE
    pniteo_hi_check := low <= pniteo_hi? 1 : pniteo_hi_check
    pniteo_lo_check := high >= pniteo_lo? 1 : pniteo_lo_check
if dayo_hi==0 // NITE SESS ACTIVE
    if low <= pdayo_hi
        pdayo_hi_check :=1
    if high >= pdayo_lo
        pdayo_lo_check :=1

pniteo_touched := pniteo_hi_check==1 and pniteo_lo_check==1
pdayo_touched := pdayo_hi_check==1 and pdayo_lo_check==1

// var daysess_hi = 0.0
