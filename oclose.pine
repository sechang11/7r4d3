// plot(timeframe.period=='60' and nz(pniteo_hi[2])!=nz(pniteo_hi[0]) and niteo_hi!=0 and not pniteo_touched==true ? D1o1 : na, style=plot.style_linebr, color=color.new(#4e50da, 50), title="D1 Open", offset=-1440/timeframe.multiplier, linewidth=8)
