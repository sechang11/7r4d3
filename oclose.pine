if high > prev_sessH and checkoncepersess5==0
    //prev_sessH := sess_hi
    checkoncepersess5 := 1
    sess_swinghi_pivot := high
    line.delete(ln_ph)
    i = 0
    while i < 400
        if sess_swinglo_pivot == sess_lo[i]
            // ln_sess_swinglo := line.new(bar_index-i-36, sess_swinglo_pivot, bar_index-i, sess_swinglo_pivot, xloc.bar_index, extend.none, color.olive, line.style_solid, 4)
