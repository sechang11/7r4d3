var ln_upgl = line.new(bar_index,0,bar_index,0)
if high > upsess_engulfcheckH and checkoncepersess3==0
    checkoncepersess3 := 1
    upsess_engulfedH := upsess_engulfcheckH
    upsess_engulfedL := upsess_engulfcheckL
    i = 0
    while i < 400
        if upsess_engulfedH == sess_hi[i] and upsess_engulfedL == sess_lo[i]
            // ln_upgh := line.new(bar_index-i-36, upsess_engulfedH, bar_index-i, upsess_engulfedH, xloc.bar_index, extend.none, color.olive, line.style_solid, 4)
