// FOREST DAY SESSION 
var d1hi1 = 0.0
var d1lo1 = 0.0


crypto_ny_hr = 14       // [DEPRECATED — DST fix below makes crypto branch use NY-local time directly, no manual toggle needed]
crypto_lo_hr = 0        // [DEPRECATED — same; lo_eff_hr now hardcodes NY 19:00 for crypto]
// crypto_lolunch_hr = 9

forexcfd_ny_hr = 09
forexcfd_lo_hr = 19
// forexcfd_lolunch_hr = 5

futures_ny_hr = 08
futures_lo_hr = 18
// futures_lolunch_hr = 4

futures_ny_hr2 = 09
futures_lo_hr2 = 19


ny_hr = syminfo.type == "crypto"? crypto_ny_hr : syminfo.type == "futures"? futures_ny_hr : forexcfd_ny_hr
lo_hr = syminfo.type == "crypto"? crypto_lo_hr : syminfo.type == "futures"? futures_lo_hr : forexcfd_lo_hr

if syminfo.ticker == "MGC1!" or syminfo.ticker == "GC1!" or syminfo.ticker == "CL1!"
    ny_hr := futures_ny_hr2
    lo_hr := futures_lo_hr2

// ── DST-aware NY hour/minute helpers ────────────────────────────────
// Crypto charts on TradingView are in UTC, which does NOT follow DST.
// A hardcoded `hour == 14` for "NY 9:30" only matches during EST winter;
// during EDT summer NY 9:30 is 13:30 UTC and the check fires an hour late.
// Futures/CFD/forex charts display in exchange-local time (Chicago Central
// or Eastern) which DOES follow DST, so plain `hour` / `minute` is fine.
// hour(time, "America/New_York") and minute(time, "America/New_York")
// return NY-local time with automatic EST/EDT handling — use these for
// crypto and rely on the chart timezone for everything else.
is_crypto     = syminfo.type == "crypto"
ny_eff_hour   = is_crypto ? hour(time,   "America/New_York") : hour
ny_eff_minute = is_crypto ? minute(time, "America/New_York") : minute
ny_eff_hr     = is_crypto ? 9  : ny_hr    // NY 9:30 day-session anchor
lo_eff_hr     = is_crypto ? 19 : lo_hr    // NY 19:00 night-session anchor

// NY 9:30 first candle — DST-safe for all symbol types via ny_eff_*
at_ny_open_first_candle = ny_eff_hour == ny_eff_hr and ny_eff_minute == 30

d1hi1 := (at_ny_open_first_candle? high : d1hi1)
d1lo1 := (at_ny_open_first_candle? low : d1lo1)

d1hi1Plot = plot(nz(d1hi1[1])==nz(d1hi1[0])? d1hi1:na, "Highs", color=(a ? color.red : na))
d1lo1Plot = plot(nz(d1lo1[1])==nz(d1lo1[0])? d1lo1:na, "Lows", color=(a ? color.red : na))
//fill(d1hi1Plot, d1lo1Plot, color.new(#1b5e20,75), fillgaps=false)

//d open + on ltf
m15high = request.security(syminfo.tickerid, '15', high, lookahead=barmerge.lookahead_on)
m15low = request.security(syminfo.tickerid, '15', low, lookahead=barmerge.lookahead_on)
var dopenhi = 0.0
var dopenlo = 0.0
dopenhi := ny_eff_hour==lo_eff_hr and ny_eff_minute==45 and timeframe.isintraday==true?m15high:dopenhi
dopenlo := ny_eff_hour==lo_eff_hr and ny_eff_minute==45 and timeframe.isintraday==true?m15low:dopenlo
// dopenhiPlot = plot(timeframe.period=='60' and nz(dopenhi[1])==nz(dopenhi[0])?dopenhi:na, "Dophi",style=plot.style_linebr, color=(a ? color.red : na))
// dopenloPlot = plot(timeframe.period=='60' and nz(dopenlo[1])==nz(dopenlo[0])?dopenlo:na, "Doplo",style=plot.style_linebr, color=(a ? color.red : na))
// fill(dopenhiPlot, dopenloPlot, color.new(color.black,50), fillgaps=false)



// SESS H L 
var prev_sess_bar_hi = 0.0
var prev_sess_bar_lo = 0.0
var sess_bar_hi = 0.0
var sess_bar_lo = 0.0
var sess_hi = 0.0
var sess_lo = 99999999.0
var sess_o = 0.0
var sess_c = 0.0
var last_sess_isup = 0
var last_sess_isdn = 0 

var prev_sessL = 0.0                // 1-break sess-swing (swing)
var prevprev_sessL = 0.0            // 2-break sess-swing (engulf)
var prev_sessH = 0.0
var prevprev_sessH = 0.0

var last_upsessH = 0.0
var last_upsessL = 0.0
var last_dnsessH = 0.0
var last_dnsessL = 0.0
var last_sessH = 0.0
var last_sessL = 0.0
var sess_clr = color.new(color.black,0)
var checkoncepersess1 = 0
var checkoncepersess2 = 0
var checkoncepersess3 = 0
var checkoncepersess4 = 0
var checkoncepersess5 = 0
var checkoncepersess6 = 0
var sess_swinghi_pivot = 0.0
var sess_swinglo_pivot = 999999999.0

var is_rb = 0

if timeframe.period=='15' or timeframe.period=='5' or timeframe.period=='1'
    var tfadjust1 = timeframe.period=='15'? 55 : timeframe.period=='5'? 165 : timeframe.period=='1'? 825 : 0
    var tfadjust2 = timeframe.period=='15'? 40 : timeframe.period=='5'? 110 : timeframe.period=='1'? 600 : 0
    //if (nz(d1hi1[1])==nz(d1hi1[0])) or (nz(dopenhi[1])==nz(dopenhi[0])) //
    if nz(d1hi1[1])!=nz(d1hi1[0])       // NY 
        prev_sess_bar_hi := sess_bar_hi
        prev_sess_bar_lo := sess_bar_lo
        sess_bar_hi := d1hi1
        sess_bar_lo := d1lo1
        sess_o := open
        sess_c := open
        line.new(bar_index, sess_hi[0], bar_index-tfadjust1, sess_hi[0], xloc.bar_index, extend.none, color=sess_clr, width=3)
        line.new(bar_index, sess_lo[0], bar_index-tfadjust1, sess_lo[0], xloc.bar_index, extend.none, color=sess_clr, width=3)
        // sess_hi := 0.0
        // sess_lo := 999999999.0

    if nz(dopenhi[1])!=nz(dopenhi[0])   // NEW DAY
        prev_sess_bar_hi := sess_bar_hi
        prev_sess_bar_lo := sess_bar_lo
        sess_bar_hi := dopenhi
        sess_bar_lo := dopenlo
        sess_o := open
        sess_c := open
        line.new(bar_index, sess_hi[0], bar_index-tfadjust2, sess_hi[0], xloc.bar_index, extend.none, color=sess_clr, width=3)
        line.new(bar_index, sess_lo[0], bar_index-tfadjust2, sess_lo[0], xloc.bar_index, extend.none, color=sess_clr, width=3)
        // sess_hi := 0.0
        // sess_lo := 999999999.0

    if nz(d1hi1[1])!=nz(d1hi1[0]) or nz(dopenhi[1])!=nz(dopenhi[0])        
        checkoncepersess1 := 0
        checkoncepersess2 := 0
        checkoncepersess3 := 0
        checkoncepersess4 := 0
        if last_sess_isup
            prevprev_sessL := prev_sessL
            prev_sessL := last_sessL
        if last_sess_isdn
            prevprev_sessH := prev_sessH
            prev_sessH := last_sessH
        last_sessH := sess_hi
        last_sessL := sess_lo
        sess_hi := high
        sess_lo := low
    else
        sess_hi := high > sess_hi? high : sess_hi
        sess_lo := low < sess_lo? low : sess_lo

    
    sess_swinghi_pivot := sess_hi > sess_swinghi_pivot? sess_hi : sess_swinghi_pivot
    sess_swinglo_pivot := sess_lo < sess_swinglo_pivot? sess_lo : sess_swinglo_pivot

