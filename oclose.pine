var upsess_engulfcheckH = 0.0       // upsess means engulfing upward (similar to last_dn_pattern, dn OB before up)
var upsess_engulfcheckL = 0.0       // holding last possible engulf values
var dnsess_engulfcheckH = 0.0       // dnsess means engulfing dnward (similar to last_up_pattern, up OB before dn)
var dnsess_engulfcheckL = 0.0

var upsess_engulfedH = 0.0          // actual engulfed sessions
