// else if nz(pdayo_hi[2])!=nz(pdayo_hi[0]) and dayo_hi!=0 and not pdayo_touched==true
//     sessibh := line.new(bar_index - offset1day, pdayo_hi, bar_index, pdayo_hi, xloc.bar_index, extend.none, color.new(color.maroon,100),line.style_solid,1)
//     sessibl := line.new(bar_index - offset1day, pdayo_lo, bar_index, pdayo_lo, xloc.bar_index, extend.none, color.new(color.maroon,100),line.style_solid,1)    
//     sessfill := linefill.new(sessibh,sessibl,color.new(color.maroon,50))
//     line.delete(sessibh[1])
//     line.delete(sessibl[1])
//     linefill.delete(sessfill[1])

/// DAY OPEN EXTENDED
sessionInfo = input.session("1800-0005", "Session")
boxType = input.string("None", "Box Type", options = ["None", "Dynamic levels", "Fixed levels"])
showBg = input.bool(false, "Show background")
squareBox = boxType == "Fixed levels"
dynamicBox = boxType == "Dynamic levels"
showBox = squareBox or dynamicBox

inSession = time(timeframe.period, sessionInfo)
invisible = color.new(#FFFFFF,100)

loLevel = ta.lowest(1)
hiLevel = ta.highest(1)
var hi = 10e-10
var lo = 10e10
// When a new period begins, reset hi/lo.

if inSession and not inSession[1]
    hi := dynamicBox ? high : hiLevel
else
    if dynamicBox
        hi := high > hi? high : hi
if inSession and not inSession[1]
    lo := dynamicBox ? low : loLevel
else
    if dynamicBox
        lo := low < lo? low : lo



// LONDON LUNCH HOUR
bgcolor(showBg and inSession ? color.maroon : na)
//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
sessionInfo2_futures = input.session("0300-0400", "Session")
sessionInfo2_cfd = input.session("0400-0500", "Session")
sessionInfo2_crypto = input.session("0900-1000", "Session")
boxType2 = input.string("Dynamic levels", "Box Type", options = ["None", "Dynamic levels", "Fixed levels"])
showBg2 = input.bool(false, "Show background")
squareBox2 = boxType2 == "Fixed levels"
dynamicBox2 = boxType2 == "Dynamic levels"
showBox2 = squareBox2 or dynamicBox2

inSession2 = time(timeframe.period, syminfo.type == "crypto"? sessionInfo2_crypto : syminfo.type == "futures"? sessionInfo2_futures : sessionInfo2_cfd)
// invisible2 = #FFFFFF

loLevel2 = ta.lowest(1)
hiLevel2 = ta.highest(1)
var hi2 = 10e-10
var lo2 = 10e10
// When a new period begins, reset hi/lo.
if inSession2 and not inSession2[1]
    hi2 := dynamicBox2 ? high : hiLevel2
else
    if dynamicBox2
        hi2 := high > hi2? high : hi2
if inSession2 and not inSession2[1]
    lo2 := dynamicBox2 ? low : loLevel2
else
    if dynamicBox2
        lo2 := low < lo2? low : lo2



// Plot background.
bgcolor(showBg2 and inSession2 ? color.maroon : na)
// //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
sessionInfo3_futures = input.session("0830-1605", "Session")
sessionInfo3_cfd = input.session("0930-1705", "Session")
sessionInfo3_crypto = input.session("0930-1705", "Session")  // NY local time; timezone param below makes this DST-aware
boxType3 = input.string("Dynamic levels", "Box Type", options = ["None", "Dynamic levels", "Fixed levels"])
showBg3 = input.bool(false, "Show background")
squareBox3 = boxType3 == "Fixed levels"
dynamicBox3 = boxType3 == "Dynamic levels"
showBox3 = squareBox3 or dynamicBox3

[m30hi, m30lo, m30o] = request.security_lower_tf(syminfo.ticker, timeframe.period=='60'? '30':na, [high, low, open])
//m30lo = request.security_lower_tf(syminfo.ticker, timeframe.period=='60'? '30':na,low)

var nyoltf_hi = 0.0
var nyoltf_lo = 0.0
var nyoltf_o = 0.0

if ny_eff_hour == ny_eff_hr and timeframe.period=='60'   // DST-safe NY open
    nyoltf_hi := getArrayValue(m30hi,1)
    nyoltf_lo := getArrayValue(m30lo,1)
    nyoltf_o := getArrayValue(m30o,1)


// plot(nyoltf_hi)
// plot(nyoltf_lo)

// Crypto branch passes "America/New_York" timezone so the session string is interpreted in NY local time
// and Pine Script automatically adjusts for EST/EDT (daylight savings). Futures and CFD branches unchanged.
inSession3 = syminfo.type == "crypto"? time(timeframe.period, sessionInfo3_crypto, "America/New_York") : time(timeframe.period, syminfo.type == "futures"? sessionInfo3_futures : sessionInfo3_cfd)
// invisible3 = #FFFFFF

loLevel3 = ta.lowest(1)
hiLevel3 = ta.highest(1)
var hi3 = 10e-10
var lo3 = 10e10
// When a new period begins, reset hi/lo.
if inSession3 and not inSession3[1]
    if timeframe.period=='60'
        hi3 := dynamicBox3 ? high > nyoltf_hi?high:nyoltf_hi : hiLevel3
    else
        hi3 := dynamicBox3 ? high : hiLevel3
else
    if dynamicBox3
        hi3 := high > hi3? high : hi3
if inSession3 and not inSession3[1]
    if timeframe.period=='60'
        lo3 := dynamicBox3 ? low < nyoltf_lo?low:nyoltf_lo : loLevel3
    else
        lo3 := dynamicBox3 ? low : loLevel3
else
    if dynamicBox3
        lo3 := low < lo3? low : lo3

// plot(nz(d1hi1[1])!=nz(d1hi1[0]) or nz(dopenhi[1])!=nz(dopenhi[0])? hi3:na)

// Plot background.
bgcolor(showBg3 and inSession3 ? color.blue : na)


// //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
sessionInfo4 = input.session("1100-1300", "Session")
boxType4 = input.string("None", "Box Type", options = ["None", "Dynamic levels", "Fixed levels"])
showBg4 = input.bool(false, "Show background")
squareBox4 = boxType4 == "Fixed levels"
dynamicBox4 = boxType4 == "Dynamic levels"
showBox4 = squareBox4 or dynamicBox4

inSession4 = time(timeframe.period, sessionInfo4)
// invisible4 = #FFFFFF

loLevel4 = ta.lowest(1)
hiLevel4 = ta.highest(1)
var hi4 = 10e-10
var lo4 = 10e10
// When a new period begins, reset hi/lo.
if inSession4 and not inSession4[1]
    hi4 := dynamicBox4 ? high : hiLevel4
else
    if dynamicBox4
        hi4 := high > hi4? high : hi4
if inSession4 and not inSession4[1]
    lo4 := dynamicBox4 ? low : loLevel4
else
    if dynamicBox4
        lo4 := low < lo4? low : lo4


// Plot background..
bgcolor(showBg4 and inSession4 ? color.purple : na)

if timeframe.period == '240' or timeframe.period == '480' or timeframe.period == 'M' or timeframe.period == 'W' or timeframe.period == 'D' //timeframe.period == '60' or 
    hi := 0
    lo := 0
    hi2 := 0
    lo2 := 0
    hi3 := 0
    lo3 := 0
    hi4 := 0
    lo4 := 0

// day open candle extended
hiPlot = plot(showBox and inSession ? hi : na, "Highs", invisible)
loPlot = plot(showBox and inSession ? lo : na, "Lows", invisible)
fill(hiPlot, loPlot, color.new(#0c3299,80))

// 5-7 am range (lo lunch?)
hiPlot2 = plot(showBox2 and inSession2 ? hi2 : na, "Highs", invisible)
loPlot2 = plot(showBox2 and inSession2 ? lo2 : na, "Lows", invisible)
fill(hiPlot2, loPlot2, color.new(#99390c, 20))

// 930 to close range
hiPlot3 = plot(showBox3 and inSession3 ? hi3 : na, "Highs", invisible)
loPlot3 = plot(showBox3 and inSession3 ? lo3 : na, "Lows", invisible)
fill(hiPlot3, loPlot3, color.new(#9e750d, 35))
plot((timeframe.period=='60' or timeframe.period=='15' or timeframe.period=='5') and inSession3? nyoltf_o: na, "ny_o", color.black, style=plot.style_steplinebr)

// 11-1pm range (ny lunch?)
hiPlot4 = plot(showBox4 and inSession4 ? hi4 : na, "Highs", invisible)
loPlot4 = plot(showBox4 and inSession4 ? lo4 : na, "Lows", invisible)
fill(hiPlot4, loPlot4, color.new(#0c3299,80))


// all sess open GRAY box hi lo fill
fill(ltfo_hiplot, ltfo_loplot,color.new(color.black,50), fillgaps=false)
fill(ltfdo_hiplot, ltfdo_loplot,color.new(color.black,50), fillgaps=false)
// gap sess prev open RED box hi lo fill

// NITE SESSION GAPS <============================================================================================================================
fill(ltfpo_hiplot, ltfpo_loplot,color.new(#5c9769,50), fillgaps=false)
// DAY SESSION GAPS
//fill(ltfpdo_hiplot, ltfpdo_loplot,color.new(color.maroon,50), fillgaps=false)

var wopenhi = 0.0
var wopenlo = 0.0

w_newperiod = request.security(syminfo.tickerid, 'W', open[1], lookahead=barmerge.lookahead_on)
var w_newperiodkey = 1 
if nz(w_newperiod[1])!=nz(w_newperiod[0])
    // label.new(bar_index,high,"newday",xloc.bar_index,yloc.abovebar)
    w_newperiodkey := 2

if w_newperiodkey==2
    if syminfo.type != "crypto"     // dayofweek==dayofweek.sunday
        //if (dayofweek==dayofweek.sunday or dayofweek==dayofweek.monday) and nz(niteo_hi[1])==nz(niteo_hi[0])
        if (nz(niteo_hi[1] != nz(niteo_hi[0])))
            wopenhi := niteo_hi
            wopenlo := niteo_lo
            //if nz(niteo_hi[1]!=nz(niteo_hi[0]))
            w_newperiodkey := 1
            // label.new(bar_index,high,"done",xloc.bar_index,yloc.abovebar)
            //wopenhi := (dayofweek==dayofweek.sunday or dayofweek==dayofweek.monday) and nz(niteo_hi[1])==nz(niteo_hi[0])?niteo_hi : wopenhi
            //wopenlo := (dayofweek==dayofweek.sunday or dayofweek==dayofweek.monday) and nz(niteo_lo[1])==nz(niteo_lo[0])?niteo_lo : wopenlo
        else
            wopenhi := wopenhi
            wopenlo := wopenlo
            //w_newperiodkey := 1

    else        // dayofweek==dayofweek.monday 
        //if dayofweek==dayofweek.monday and hour<14 and nz(niteo_hi[1])==nz(niteo_hi[0])
        if (nz(niteo_hi[1] == nz(niteo_hi[0])))    
            wopenhi := niteo_hi
            wopenlo := niteo_lo
            //if nz(niteo_hi[1]!=nz(niteo_hi[0]))
            w_newperiodkey := 1
            // label.new(bar_index,high,"done",xloc.bar_index,yloc.abovebar)
        else
            wopenhi := wopenhi
            wopenlo := wopenlo
            
        // wopenhi := dayofweek==dayofweek.monday and hour<14 and nz(niteo_hi[1])==nz(niteo_hi[0])?niteo_hi : wopenhi
        // wopenlo := dayofweek==dayofweek.monday and hour<14 and nz(niteo_lo[1])==nz(niteo_lo[0])?niteo_lo : wopenlo
else
    wopenhi := wopenhi
    wopenlo := wopenlo


wopenhi_plot = plot(wopenhi, color=invisible)
wopenlo_plot = plot(wopenlo, color=invisible)
// weekly open range extended
fill(wopenhi_plot, wopenlo_plot, color.new(color.olive, 72), fillgaps=false)
