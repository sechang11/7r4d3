            break
        i += 1
if high > prevprev_sessH
    line.delete(ln_pph)

var ln_sess_swinghi = line.new(bar_index,0,bar_index,0)
if low < prev_sessL and checkoncepersess6==0
    //prev_sessL := sess_lo
    checkoncepersess6 := 1
    sess_swinglo_pivot := low
    line.delete(ln_pl)
    i = 0
    while i < 400
        if sess_swinghi_pivot == sess_hi[i]
            // ln_sess_swinghi := line.new(bar_index-i-36, sess_swinghi_pivot, bar_index-i, sess_swinghi_pivot, xloc.bar_index, extend.none, color.olive, line.style_solid, 4)
            //line.delete(ln_sess_swinghi[3])
