var ln_ph = line.new(bar_index,0,bar_index,0)
if low < last_sessL and checkoncepersess1==0
    last_sess_isdn := 1
    last_sess_isup := 0
    checkoncepersess5 := 0
    checkoncepersess1 := 1
    upsess_engulfcheckH := last_sessH
    upsess_engulfcheckL := last_sessL
