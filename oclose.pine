ltfo_loplot = plot(nz(niteo_lo[1])==nz(niteo_lo[0])?niteo_lo:na, "ltfo_lo",style=plot.style_linebr, color=(a ? color.red : na))
// CURR DAY
ltfdo_hiplot = plot(nz(dayo_hi[1])==nz(dayo_hi[0])?dayo_hi:na, "ltfo_hi",style=plot.style_linebr, color=(a ? color.red : na))
ltfdo_loplot = plot(nz(dayo_lo[1])==nz(dayo_lo[0])?dayo_lo:na, "ltfo_lo",style=plot.style_linebr, color=(a ? color.red : na))

/// PREV NITE
ltfpo_hiplot = plot(nz(pniteo_hi[1])==nz(pniteo_hi[0]) and niteo_hi!=0 and not pniteo_touched==true?pniteo_hi:na, "ltfpo_hi",style=plot.style_linebr, color=(a ? color.red : na), offset=offset1day) //  and niteo_hi!=0
ltfpo_loplot = plot(nz(pniteo_lo[1])==nz(pniteo_lo[0]) and niteo_hi!=0 and not pniteo_touched==true?pniteo_lo:na, "ltfpo_lo",style=plot.style_linebr, color=(a ? color.red : na), offset=offset1day) //  and niteo_hi!=0
// PREV DAY
ltfpdo_hiplot = plot(nz(pdayo_hi[1])==nz(pdayo_hi[0]) and dayo_hi!=0 and not pdayo_touched==true?pdayo_hi:na, "ltfpdo_hi",style=plot.style_linebr, color=(a ? color.red : na), offset=offset1day) // and dayo_hi!=0
ltfpdo_loplot = plot(nz(pdayo_lo[1])==nz(pdayo_lo[0]) and dayo_hi!=0 and not pdayo_touched==true?pdayo_lo:na, "ltfpdo_lo",style=plot.style_linebr, color=(a ? color.red : na), offset=offset1day) // and dayo_hi!=0
