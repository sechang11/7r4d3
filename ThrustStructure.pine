//@version=5
indicator("H1 Thrust Structure - Live", overlay=true, max_lines_count=500, max_labels_count=500)

// --- Global Variable Declarations ---
var float highPriceholder = na
var int   highTimeholder  = na
var float lowPriceholder  = na
var int   lowTimeholder   = na
var float swingHigh       = na
var float swingLow        = na
var float BelowChochLevel = na
var float AboveChochLevel = na
var int   tTrend          = 1
var int   tFlow           = 1
var bool  check4UpBos     = false
var bool  check4DnBos     = false
var int   lastUpBos_candle = na
var int   lastDnBos_candle = na

// Arrays to store thrust data
var array<float> DnThrusts_SwingHigh = array.new_float(0)
var array<float> UpThrusts_SwingLow  = array.new_float(0)
var array<line>  thrust_lines        = array.new_line(0)

// --- Functions ---
isLowPivot() =>
    low[0] <= low[1] and low[0] <= low[2] and low[0] <= low[3] and low[0] <= low[4]

isHighPivot() =>
    high[0] >= high[1] and high[0] >= high[2] and high[0] >= high[3] and high[0] >= high[4]

// --- Logic Execution ---

// Pre-calculate the 4-bar extremes (needed for thrust logic)
highestHighof4 = ta.highest(high, 4)[1]
lowestLowof4   = ta.lowest(low, 4)[1]

// Update High & Low Placeholders
if isLowPivot()
    lowTimeholder  := bar_index
    lowPriceholder := low

if isHighPivot()
    highTimeholder  := bar_index
    highPriceholder := high

// --- Thrust Logic ---
// Down Thrust
if timeframe.period=='15' or timeframe.period=='60'
    if tFlow == 1
        if low < lowestLowof4
            swingHigh := highPriceholder
            tFlow := 2
            check4UpBos := true
            array.push(DnThrusts_SwingHigh, swingHigh)
            l = line.new(highTimeholder, swingHigh, highTimeholder+3, swingHigh, color=color.olive, width=6)
            array.push(thrust_lines, l)

    // Up Thrust
    if tFlow == 2
        if high > highestHighof4
            swingLow := lowPriceholder
            tFlow := 1
            check4DnBos := true
            array.push(UpThrusts_SwingLow, swingLow)
            l = line.new(lowTimeholder, swingLow, lowTimeholder+3, swingLow, color=color.olive, width=6)
            array.push(thrust_lines, l)

    if tFlow == 1
        if low < lowestLowof4
            swingHigh := highPriceholder
            tFlow := 2
            check4UpBos := true
            array.push(DnThrusts_SwingHigh, swingHigh)
            l = line.new(highTimeholder, swingHigh, highTimeholder+3, swingHigh, color=color.olive, width=6)
            array.push(thrust_lines, l)


    // --- BOS Logic ---
    // Up BOS
    //if tTrend == 1 and check4UpBos //and bar_index != lastUpBos_candle
    if check4UpBos //and bar_index != lastUpBos_candle
        if high > swingHigh
            BelowChochLevel := array.size(UpThrusts_SwingLow) > 0 ? array.get(UpThrusts_SwingLow, array.size(UpThrusts_SwingLow) - 1) : na
            //lastUpBos_candle := bar_index
            check4UpBos := false
            if array.size(thrust_lines) > 0
                line.set_color(array.get(thrust_lines, array.size(thrust_lines) - 1), tTrend==2? color.maroon : color.green)
            tTrend := 1
    // Down BOS
    //if tTrend == 2 and check4DnBos //and bar_index != lastDnBos_candle
    if check4DnBos //and bar_index != lastDnBos_candle
        if low < swingLow
            AboveChochLevel := array.size(DnThrusts_SwingHigh) > 0 ? array.get(DnThrusts_SwingHigh, array.size(DnThrusts_SwingHigh) - 1) : na
            //lastDnBos_candle := bar_index
            check4DnBos := false
            if array.size(thrust_lines) > 0
                line.set_color(array.get(thrust_lines, array.size(thrust_lines) - 1), tTrend==1? color.maroon : color.green)
            tTrend := 2


    var line flowLine      = na
    var line swingHighTrendLine = na
    var line swingLowTrendLine = na

    // ───── FLOW LINE (unchanged) ─────
    if tFlow == 1
        if tFlow != tFlow[1]
            if not na(flowLine)
                line.delete(flowLine)
            flowLine := na

        if na(flowLine)
            flowLine := line.new(bar_index, lowestLowof4, bar_index + 1, lowestLowof4, color=color.rgb(13, 54, 59), width=2, extend=extend.right, style=line.style_solid)
        else
            line.set_xy1(flowLine, bar_index, lowestLowof4),
            line.set_xy2(flowLine, bar_index + 1, lowestLowof4)

    if tFlow == 2
        if tFlow != tFlow[1]
            if not na(flowLine)
                line.delete(flowLine)
            flowLine := na

        if na(flowLine)
            flowLine := line.new(bar_index, highestHighof4, bar_index + 1, highestHighof4, color=color.rgb(13, 54, 59), width=2, extend=extend.right, style=line.style_solid)
        else
            line.set_xy1(flowLine, bar_index, highestHighof4),
            line.set_xy2(flowLine, bar_index + 1, highestHighof4)


    // ───── SWING TRENDLINES ─────

    // SWINGHIGH TRENDLINE
    if swingHigh != swingHigh[1]
        if not na(swingHighTrendLine)
            line.delete(swingHighTrendLine)
        swingHighTrendLine := na

    if na(swingHighTrendLine)
        swingHighTrendLine := line.new(bar_index, swingHigh, bar_index + 1, swingHigh, color= tTrend==1? color.green : color.maroon, width=2, extend=extend.right)
    else
        line.set_y1(swingHighTrendLine, swingHigh),
        line.set_y2(swingHighTrendLine, swingHigh)

    // SWINGLOW TRENDLINE

    if swingLow != swingLow[1]
        if not na(swingLowTrendLine)
            line.delete(swingLowTrendLine)
        swingLowTrendLine := na

    if na(swingLowTrendLine)
        swingLowTrendLine := line.new(bar_index, swingLow, bar_index + 1, swingLow, color=tTrend==1? color.green : color.maroon, width=2, extend=extend.right)
    else
        line.set_y1(swingLowTrendLine, swingLow),
        line.set_y2(swingLowTrendLine, swingLow)


    // VS TREND LINE

    var line vsTrend_line = na
    var float sl_level = na

    if tFlow == 1 and close > swingHigh
        if not na(vsTrend_line)
            line.delete(vsTrend_line)
        vsTrend_line := na

        if na(vsTrend_line)
            sl_level := close + (close - swingLow)
            vsTrend_line := line.new(bar_index, sl_level, bar_index + 1, sl_level, color=color.red, width=2, extend=extend.right)
        else
            line.set_y1(vsTrend_line, sl_level),
            line.set_y2(vsTrend_line, sl_level)
    else
        line.delete(vsTrend_line)


    if tFlow == 2 and close < swingLow
        if not na(vsTrend_line)
            line.delete(vsTrend_line)
        vsTrend_line := na

        if na(vsTrend_line)
            sl_level := close - (swingHigh - close)
            vsTrend_line := line.new(bar_index, sl_level, bar_index + 1, sl_level, color=color.red, width=2, extend=extend.right)
        else
            line.set_y1(vsTrend_line, sl_level),
            line.set_y2(vsTrend_line, sl_level)
    else
        line.delete(vsTrend_line)


    // --- CHoCH Logic ---
    // Down CHoCH/

    // if tTrend == 1 //and bar_index != lastUpBos_candle
    //     if not na(BelowChochLevel) and low < BelowChochLevel
    //         check4DnBos := false
    //         AboveChochLevel := array.size(DnThrusts_SwingHigh) > 0 ? array.get(DnThrusts_SwingHigh, array.size(DnThrusts_SwingHigh) - 1) : na
    //         tTrend := 2
    //         if array.size(thrust_lines) > 0
    //             line.set_color(array.get(thrust_lines, array.size(thrust_lines) - 1), color.maroon)

    // // Up CHoCH
    // else if tTrend == 2 //and bar_index != lastDnBos_candle
    //     if not na(AboveChochLevel) and high > AboveChochLevel
    //         check4UpBos := false
    //         BelowChochLevel := array.size(UpThrusts_SwingLow) > 0 ? array.get(UpThrusts_SwingLow, array.size(UpThrusts_SwingLow) - 1) : na
    //         tTrend := 1
    //         if array.size(thrust_lines) > 0
    //             line.set_color(array.get(thrust_lines, array.size(thrust_lines) - 1), color.maroon)
//chochline = tTrend==1? swingLow : swingHigh
//plot(chochline[1]==chochline[0]? chochline : na, "chochline", tTrend==1? color.maroon : color.green, 2, plot.style_steplinebr)
//alertcondition(tTrend[1]!=tTrend[0], "tTrend Crossover", '{"content" : "{{ticker}} Crossover!"}')
var new_ttrend_alert_message = ""
new_ttrend_alert_message := '{"content": "Crossover! ' + syminfo.ticker + " " + timeframe.period +  "    " + str.tostring(hour) + ":" + str.tostring(minute) + "  trend:  " + str.tostring(tTrend) + '", "username": "New Trend!"}'
if tTrend[0] != tTrend[1]
    alert(new_ttrend_alert_message, alert.freq_once_per_bar)

plot(swingHigh[1] == swingHigh[0] or swingHigh[1] != swingHigh[0]? swingHigh : na, color=#4B0082, linewidth=2, style=plot.style_linebr)
plot(swingLow[1] == swingLow[0] or swingLow[1] != swingLow[0]? swingLow : na, color=#4B0082, linewidth=2, style=plot.style_linebr)

//plot(AboveChochLevel)
// --- Visual Indicators ---
//plotchar(tTrend == 1, "Bullish Trend", "▲", location.bottom, color.green, size=size.tiny)
//plotchar(tTrend == 2, "Bearish Trend", "▼", location.top, color.red, size=size.tiny)

//plot(tTrend == 1 ? BelowChochLevel : na, "Below CHoCH Level", color.new(color.green, 70), 2, plot.style_circles)
//plot(tTrend == 2 ? AboveChochLevel : na, "Above CHoCH Level", color.new(color.red, 70), 2, plot.style_circles)


// ── T.MTX – Thrust Matrix Level (price position within last two swings) ──
var label tmtx_label = na
var line  tmtx_topLine = na
var line  tmtx_botLine = na

if (timeframe.period == '15' or timeframe.period == '60') and barstate.islast
    tmtx_range = swingHigh - swingLow
    tmtx_pct   = tmtx_range > 0 ? (close - swingLow) / tmtx_range * 100.0 : na
    tmtx_level = not na(tmtx_pct) ? math.round(tmtx_pct) : na

    // Fair (F) = within range, Unfair (U) = outside
    tmtx_isFair = tmtx_range > 0 and close >= swingLow and close <= swingHigh
    tmtx_fu     = tmtx_isFair ? "F" : "U"
    // Deep retracement: bearish trend 67+, bullish trend 33-
    tmtx_deepRet = tmtx_isFair and not na(tmtx_level) and ((tTrend == 2 and tmtx_level >= 67) or (tTrend == 1 and tmtx_level <= 33))
    tmtx_txt    = not na(tmtx_level) ? tmtx_fu + " " + str.tostring(tmtx_level) + (tmtx_deepRet ? " !" : "") : ""

    // Color based on trend
    tmtx_clr = tTrend == 1 ? color.green : color.maroon
    tmtx_sz  = tmtx_deepRet ? size.huge : size.large

    // Anchor Y at the most recent swing level
    tmtx_lastSwingIsHigh = not na(highTimeholder) and not na(lowTimeholder) ? highTimeholder > lowTimeholder : not na(highTimeholder)
    tmtx_y = tmtx_lastSwingIsHigh ? swingHigh : swingLow

    // Draw label to the right
    if not na(tmtx_label)
        label.delete(tmtx_label)
    tmtx_label := label.new(bar_index + 20, tmtx_y, tmtx_txt, xloc.bar_index, yloc.price, color(na), label.style_none, tmtx_clr, tmtx_sz, text.align_left)

    // Debug lines at swing range boundaries
    if not na(tmtx_topLine)
        line.delete(tmtx_topLine)
    if not na(tmtx_botLine)
        line.delete(tmtx_botLine)
    if tmtx_range > 0
        tmtx_topLine := line.new(bar_index, swingHigh, bar_index + 3, swingHigh, color=color.black, style=line.style_solid, width=4)
        tmtx_botLine := line.new(bar_index, swingLow, bar_index + 3, swingLow, color=color.black, style=line.style_solid, width=4)
